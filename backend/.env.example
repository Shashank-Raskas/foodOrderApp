# Copy to .env.development (local) — the server loads .env.<NODE_ENV>, defaulting to "development".
# On Render, set these in the service's Environment tab instead.

NODE_ENV=development
PORT=3000

# Firebase service account JSON on one line. Locally you can leave this unset and put
# service-account-key.json next to app.js instead.
FIREBASE_CREDENTIALS=

# Required when deployed (the server refuses to start without them). Use long random strings, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Extra browser origins allowed to call the API when deployed (comma-separated).
# https://foodorderapp-99re.onrender.com is always allowed.
ALLOWED_ORIGINS=

# Email OTP + order confirmations via Brevo. Without BREVO_API_KEY, OTPs are printed to the console.
BREVO_API_KEY=
SENDER_EMAIL=

# Optional SMS OTP via Twilio (also needs `npm install twilio`)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
